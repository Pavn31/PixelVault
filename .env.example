DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
POSTGRES_DB=pixelvault
POSTGRES_USER=pixelvault
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
PIXELVAULT_MAX_UPLOAD_BYTES=536870912
PIXELVAULT_TEMP_RETENTION_SECONDS=3600
PIXELVAULT_CLAMAV_REQUIRED=true
PIXELVAULT_MEDIA_MODERATION_REQUIRED=true
# Vetted provider receives: <temporary-path> <mime-type> and must return JSON.
# Allowed response: {"decision":"allow","labels":[]}
# Any CSAM, child_sexual_abuse, pornography, sexual_explicit, gore, or graphic_violence label is rejected.
# PIXELVAULT_MEDIA_MODERATION_COMMAND=/usr/local/bin/pixelvault-media-moderator
PIXELVAULT_FFPROBE_BINARY=ffprobe
PIXELVAULT_FFMPEG_BINARY=ffmpeg
